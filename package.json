{
  "name": "@rohanpoudel2/qrs",
  "version": "0.1.0",
  "description": "Generate and verify QR codes from code, the terminal, CI, or an agent.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "ROADMAP.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./png": {
      "types": "./dist/png.d.ts",
      "import": "./dist/png.js"
    },
    "./scan": {
      "types": "./dist/scan.d.ts",
      "import": "./dist/scan.js"
    },
    "./rotate": {
      "types": "./dist/rotate.d.ts",
      "import": "./dist/rotate.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "qrs": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "test:stress": "npm run build && node --test --test-concurrency=1 test/stress.test.mjs",
    "test:benchmark": "npm run build && node --test --test-concurrency=1 test/performance.test.mjs",
    "benchmark": "npm run build && node bench/benchmark.mjs",
    "benchmark:json": "npm run build && node bench/benchmark.mjs --json",
    "prepack": "npm test"
  },
  "author": "Rohan Poudel",
  "packageManager": "npm@11.6.2",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "fast-png": "^8.0.0",
    "jpeg-js": "^0.4.4",
    "qr": "0.7.0",
    "zxing-wasm": "^3.1.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "qrcode": "^1.5.4",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rohanpoudel2/qrs.git"
  },
  "bugs": {
    "url": "https://github.com/rohanpoudel2/qrs/issues"
  },
  "homepage": "https://github.com/rohanpoudel2/qrs#readme",
  "keywords": [
    "qr",
    "qrcode",
    "cli",
    "agent",
    "ci",
    "svg",
    "png",
    "scanner",
    "performance",
    "webassembly",
    "rotating-qr",
    "membership"
  ]
}
